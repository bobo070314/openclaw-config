# OpenClaw Delivery Environment
# Copy this to .env and fill in your API tokens

# OpenClaw Gateway API Key
OPENCLAW_API_KEY=

# DeepSeek API (optional, if using direct DeepSeek models)
DEEPSEEK_API_KEY=

# Zhipu API (optional)
ZHIPU_API_KEY=

# Gateway URL (default: http://localhost:18900)
GATEWAY_URL=http://localhost:18900
