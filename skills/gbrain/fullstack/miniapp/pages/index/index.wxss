/** gbrain 首页样式 */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  text-align: center;
  padding: 40rpx 0;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #888;
  margin-top: 10rpx;
}

.search-box {
  display: flex;
  margin: 20rpx 0;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border: 1px solid #ddd;
}

.search-btn {
  margin-left: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 30rpx;
  background: #1a1a2e;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.kb-selector {
  margin: 20rpx 0;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
}

.picker {
  font-size: 28rpx;
  color: #333;
}

.results {
  margin-top: 20rpx;
}

.result-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.result-content {
  font-size: 26rpx;
  color: #666;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.result-meta {
  margin-top: 10rpx;
}

.score {
  font-size: 22rpx;
  color: #999;
}

.empty, .loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}
