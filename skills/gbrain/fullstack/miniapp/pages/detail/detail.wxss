.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.doc-header {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.doc-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
  display: block;
}

.doc-meta {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
}

.doc-type, .doc-score {
  font-size: 24rpx;
  color: #999;
}

.doc-tags {
  margin-bottom: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  background: #e8e8ff;
  color: #1a1a2e;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.doc-content {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
  word-break: break-all;
}
