{
  "name": "db-migrations",
  "version": "0.2.0",
  "entrypoint": "./run.bat",
  "status": "implemented",
  "type": "script",
  "args": [
    {
      "name": "projectDir",
      "type": "string",
      "description": "Path to Next.js project containing prisma/schema.prisma",
      "required": true
    }
  ],
  "env": [
    {
      "name": "DATABASE_URL",
      "description": "Database connection string for Prisma",
      "required": true
    }
  ],
  "output": {
    "success": "Migration applied + log entry",
    "failure": "Migration failed or skipped (no DATABASE_URL)"
  }
}
